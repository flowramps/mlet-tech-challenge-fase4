# Copiar para .env e ajustar. Toda variável usa o prefixo CREDITO_ (ver src/credito/config.py).
# Nenhuma delas é obrigatória: os valores abaixo são os defaults já embutidos em Settings.

# Os quatro diretórios são a exceção, e é por isso que estão comentados: o default deles é
# **absoluto**, ancorado na raiz do repositório (PROJECT_ROOT, em src/credito/config.py).
# Definir qualquer um com caminho relativo troca essa âncora pelo diretório de trabalho do
# processo — os dois só coincidem quando o comando roda da raiz. Descomente apenas se
# quiser mesmo mudar o destino dos artefatos, e prefira caminho absoluto.
# CREDITO_DATA_DIR=/caminho/absoluto/para/data
# CREDITO_MODELS_DIR=/caminho/absoluto/para/models
# CREDITO_METRICS_DIR=/caminho/absoluto/para/metrics
# CREDITO_REPORTS_DIR=/caminho/absoluto/para/reports

# Reprodutibilidade e particionamento dos dados.
CREDITO_RANDOM_SEED=42
CREDITO_TEST_SIZE=0.2
CREDITO_VALIDATION_SIZE=0.2

# Pisos do gate de promoção do modelo. Calibrados a partir do campeão medido no conjunto
# de teste (auc_pr 0,3716 e recall positivo 0,6915), menos margem de 0,05.
CREDITO_MIN_AUC_PR=0.3216
CREDITO_MIN_RECALL_POSITIVO=0.6415

# Limiares de PSI para classificação de severidade do drift. Convenção de risco de
# crédito, não medição deste dataset (ver src/credito/config.py).
CREDITO_PSI_ATENCAO=0.1
CREDITO_PSI_CRITICO=0.25
